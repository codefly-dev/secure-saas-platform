                "deny": {
                  "conditions": {
                    "all": [
                      {
                        "key": "{{ request.object.spec.schedulerName || 'default-scheduler' }}",
                        "operator": "NotEquals",
                        "value": "default-scheduler"
                      }
                    ]
                  }
                }
              }
            },
            {
              "name": "require-database-pod-controller-owner",
              "match": {
                "any": [
                  {
                    "resources": {
                      "kinds": ["Pod"],
                      "namespaces": ["database-bootstrap"]
                    }
                  }
                ]
              },
              "validate": {
                "message": "SEC_DATABASE_POD_OWNER_DENIED",
                "pattern": {
                  "metadata": {
                    "ownerReferences": [{ "controller": true, "kind": "Job" }]
                  }
                }
              }
            },
            {
              "name": "restrict-database-workload-kind",
              "match": {
                "any": [
                  {
                    "resources": {
                      "kinds": [
                        "Deployment",
                        "DaemonSet",
                        "CronJob",
                        "StatefulSet",
                        "ReplicaSet",
                        "ReplicationController"
                      ],
                      "namespaces": ["database-bootstrap"]
                    }
                  }
                ]
              },
              "validate": {
                "message": "SEC_DATABASE_WORKLOAD_KIND_DENIED",
                "deny": {
                  "conditions": {
                    "all": [
                      { "key": true, "operator": "Equals", "value": true }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
