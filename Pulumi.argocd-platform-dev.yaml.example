environment:
  - secure-saas-infra/dev
config:
  aws:region: us-east-1
  secure-saas-infra:stackKind: argocd
  secure-saas-infra:deploymentMode: disabled
  secure-saas-infra:organizationName: deus
  secure-saas-infra:environment: argocd-platform-dev
  secure-saas-infra:argocd:
    # Pulumi stack name of the cluster this Argo CD instance manages.
    clusterStackRef: your-pulumi-org/secure-saas-infra/platform-dev
    # Key in the cluster stack's eksClusters output (matches the spoke name).
    clusterName: platform-dev
    clusterRole: platform
    clusterAccessRoleArn: arn:aws:iam::<set-platform-dev-account-id-after-organization-creation>:role/InfrastructureApplyNonProd-Workload
    argocdHostname: argocd-platform-dev.mind.example
    chartVersion: "10.2.1"
    bootstrap:
      repository: https://github.com/codefly-dev/secure-saas-infra.git
      revision: 6f009581b7148b09d5341bbdc791200c78ba3e57
      entrypoint: gitops/bootstrap/argocd/overlays/dev/platform
    oidcIssuer: https://identity.mind.example
    oidcClientId: argocd-platform-dev
    oidcClientSecretRef: $oidc.organization.clientSecret
    oidcAdminGroup: deus:infra:admins
