environment:
  - secure-saas-infra/dev
config:
  aws:region: us-east-1
  secure-saas-infra:stackKind: argocd
  secure-saas-infra:deploymentMode: disabled
  secure-saas-infra:organizationName: deus
  secure-saas-infra:environment: argocd-execution-dev
  secure-saas-infra:argocd:
    # Pulumi stack name of the cluster this Argo CD instance manages.
    clusterStackRef: your-pulumi-org/secure-saas-infra/execution-dev
    # Key in the cluster stack's eksClusters output (matches the spoke name).
    clusterName: execution-dev
    clusterRole: execution
    clusterAccessRoleArn: arn:aws:iam::<set-execution-dev-account-id-after-organization-creation>:role/InfrastructureApplyNonProd-Workload
    argocdHostname: argocd-execution-dev.mind.example
    chartVersion: "10.2.1"
    bootstrap:
      repository: https://github.com/codefly-dev/secure-saas-infra.git
      revision: 1d4c55a3bff945522c456179739aabcc67395539
      entrypoint: gitops/bootstrap/argocd/overlays/dev/execution
    oidcIssuer: https://identity.mind.example
    oidcClientId: argocd-execution-dev
    oidcClientSecretRef: $oidc.organization.clientSecret
    oidcAdminGroup: deus:infra:admins
