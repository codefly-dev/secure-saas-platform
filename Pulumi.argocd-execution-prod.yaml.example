environment:
  - secure-saas-infra/production
config:
  aws:region: us-east-1
  secure-saas-infra:stackKind: argocd
  secure-saas-infra:deploymentMode: disabled
  secure-saas-infra:organizationName: deus
  secure-saas-infra:environment: argocd-execution-prod
  secure-saas-infra:argocd:
    # Pulumi stack name of the cluster this Argo CD instance manages.
    clusterStackRef: your-pulumi-org/secure-saas-infra/execution-prod
    # Key in the cluster stack's eksClusters output (matches the spoke name).
    clusterName: execution-prod
    argocdHostname: argocd-execution-prod.mind.example
    chartVersion: "8.4.0"
    # Bootstrap directory relative to the Pulumi run cwd. The Argo CD
    # stack must run from the repo root so this resolves to gitops/...
    bootstrapDirectory: gitops/bootstrap/argocd
