environment:
  - secure-saas-infra/staging
config:
  aws:region: us-east-1
  secure-saas-infra:stackKind: argocd
  secure-saas-infra:deploymentMode: disabled
  secure-saas-infra:organizationName: deus
  secure-saas-infra:environment: argocd-execution-staging
  secure-saas-infra:argocd:
    # Pulumi stack name of the cluster this Argo CD instance manages.
    clusterStackRef: your-pulumi-org/secure-saas-infra/execution-staging
    # Key in the cluster stack's eksClusters output (matches the spoke name).
    clusterName: execution-staging
    clusterRole: execution
    clusterAccessRoleArn: arn:aws:iam::<set-execution-staging-account-id-after-organization-creation>:role/InfrastructureApplyNonProd-Workload
    argocdHostname: argocd-execution-staging.mind.example
    chartVersion: "10.2.1"
    bootstrapRepository: https://github.com/codefly-dev/secure-saas-infra.git
    bootstrapRevision: 17c2aab74a2dadab146d2d63d4e1fa97e057c922
    oidcIssuer: https://identity.mind.example
    oidcClientId: argocd-execution-staging
    oidcClientSecretRef: $oidc.organization.clientSecret
    oidcAdminGroup: deus:infra:admins
    # Bootstrap directory relative to the Pulumi run cwd. The Argo CD
    # stack must run from the repo root so this resolves to gitops/...
    bootstrapDirectory: gitops/bootstrap/argocd/overlays/staging/execution
