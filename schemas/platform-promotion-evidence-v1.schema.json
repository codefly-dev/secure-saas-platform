{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security.deus.dev/schemas/platform-promotion-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "environment",
    "clusterRole",
    "application",
    "source",
    "observed",
    "evidenceDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "evidence.deus.dev/platform-promotion/v1"
    },
    "kind": { "const": "PlatformPromotionEvidence" },
    "environment": { "const": "production" },
    "clusterRole": { "enum": ["platform", "execution"] },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "requestedRevision", "resolvedRevision"],
      "properties": {
        "repository": {
          "const": "https://github.com/codefly-dev/secure-saas-platform.git"
        },
        "requestedRevision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|v\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?)$"
        },
        "resolvedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "revision", "syncStatus", "healthStatus"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "syncStatus": { "const": "Synced" },
        "healthStatus": { "const": "Healthy" }
      }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
